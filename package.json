{
  "name": "gosheet",
  "version": "1.0.0",
  "description": "Lightweight spreadsheet application with Electron and Go backend",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "NODE_ENV=test playwright test",
    "test:unit": "go test ./tests/...",
    "test:all": "npm run test:unit && npm test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "dev": "electron . --dev"
  },
  "keywords": [
    "spreadsheet",
    "electron",
    "go"
  ],
  "author": "Yaron",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "electron": "^30.5.1",
    "electron-builder": "^26.7.0",
    "electron-playwright-helpers": "^1.7.1",
    "playwright": "^1.48.2"
  },
  "build": {
    "appId": "com.gosheet.app",
    "productName": "GoSheet",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "extraResources": [
        {
          "from": "server/gosheet-server",
          "to": "server/gosheet-server"
        }
      ]
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  }
}
