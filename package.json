{
  "name": "gosheet",
  "version": "1.0.0",
  "description": "Lightweight spreadsheet application with Electron and Go backend",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:verbose": "electron . --verbose",
    "build": "electron-builder",
    "test": "NODE_ENV=test playwright test",
    "test:unit": "go test ./tests/...",
    "test:all": "npm run test:unit && npm test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "dev": "electron . --dev",
    "lint": "eslint frontend/ electron/ playwright_tests/",
    "format": "prettier --write 'frontend/**/*.{js,css}' 'electron/**/*.js' 'playwright_tests/**/*.js'",
    "format:check": "prettier --check 'frontend/**/*.{js,css}' 'electron/**/*.js' 'playwright_tests/**/*.js'",
    "prepare": "husky"
  },
  "keywords": [
    "spreadsheet",
    "electron",
    "go"
  ],
  "author": "Yaron",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "electron": "^30.5.1",
    "electron-builder": "^26.7.0",
    "electron-playwright-helpers": "^1.7.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.48.2",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.{js,css}": ["eslint --fix", "prettier --write"],
    "*.go": ["gofmt -w"]
  },
  "build": {
    "appId": "com.gosheet.app",
    "productName": "GoSheet",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "default",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/Icon.png",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "GoSheet Spreadsheet",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.gosheet.sheet"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.gosheet.sheet",
            "UTTypeDescription": "GoSheet Spreadsheet",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "sheet"
              ]
            }
          }
        ]
      },
      "extraResources": [
        {
          "from": "server/gosheet-server",
          "to": "server/gosheet-server"
        },
        {
          "from": "frontend",
          "to": "frontend"
        },
        {
          "from": "docs/USER_GUIDE.md",
          "to": "docs/USER_GUIDE.md"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "sheet",
        "name": "GoSheet Spreadsheet",
        "description": "GoSheet spreadsheet file",
        "role": "Editor"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "frontend/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "showdown": "^2.1.0"
  }
}
